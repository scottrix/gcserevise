      "ao": "AO3",
      "difficulty": 4,
      "markScheme": {
        "points": [
          { "text": "Let width = x, length = x + 3", "marks": 1, "guidance": "Correctly defines variables" },
          { "text": "Perimeter = 2(x + x + 3) = 36 OR 2x + 2(x + 3) = 36", "marks": 1, "guidance": "Correct equation for perimeter" },
          { "text": "4x + 6 = 36 → 4x = 30", "marks": 1, "guidance": "Correct simplification" },
          { "text": "x = 7.5, so width = 7.5 cm, length = 10.5 cm", "marks": 1, "guidance": "Correct solution with units" }
        ],
        "exemplarAnswer": "Let width = x cm, length = (x + 3) cm. Perimeter = 2[x + (x + 3)] = 36. 2(2x + 3) = 36. 4x + 6 = 36. 4x = 30. x = 7.5. Width = 7.5 cm, Length = 10.5 cm.",
